# inputs.env -- default input files for the run scripts
# (scripts/sweep.sh, scripts/sweep-klein.sh, scripts/smoke.sh).
#
# The scripts source input/inputs.env when it exists, otherwise this file.
# input/ is gitignored, but scripts/bundle.sh packs it into pod bundles, so a
# copy of this file there travels with your runs.
#
# The ${VAR:-...} guards keep one-off environment overrides working:
#     CLIP=input/other.mp4 scripts/sweep.sh
# Plain assignments (CLIP=input/my.mp4) work too, but then the file wins over
# the environment for that variable.

IMG="${IMG:-input_example/test_512.png}"
CLIP="${CLIP:-input_example/video_cropped.mp4}"
